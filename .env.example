# Copy this file to .env and replace the example values before starting Docker Compose.
DB_USERNAME=shopkart
DB_PASSWORD=replace-with-a-strong-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-strong-root-password
DB_URL=jdbc:mysql://mysql:3306/shopkart?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
JWT_SECRET=replace-with-a-private-random-secret-of-at-least-32-characters
JWT_EXPIRATION_MS=3600000
SHOPKART_CATALOG_IMPORT_ON_START=true
CORS_ALLOWED_ORIGINS=http://localhost:5173
FRONTEND_PORT=8080
VITE_API_URL=/api
